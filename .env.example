# ── Required ──────────────────────────────────────────────────
# Telegram Bot
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=your_bot_username
BOT_WEBHOOK_URL=https://your-domain.com/webhook

# PostgreSQL (no defaults — must be set)
POSTGRES_DB=taskbot
POSTGRES_USER=taskbot
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_URL=jdbc:postgresql://localhost:5432/taskbot

# Encryption (32-byte hex for AES-256 — generate with: openssl rand -hex 16)
ENCRYPTION_SECRET_KEY=change_me_to_a_random_32_byte_hex

# ── Optional ─────────────────────────────────────────────────
# Admin users (comma-separated Telegram IDs)
ADMIN_TELEGRAM_IDS=

# CORS origins (comma-separated, no spaces)
CORS_ALLOWED_ORIGINS=https://your-domain.com

# Rate Limiting
RATE_LIMIT_CAPACITY=30
RATE_LIMIT_REFILL_PER_MINUTE=20