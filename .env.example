# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=your_bot_username
BOT_WEBHOOK_URL=https://your-domain.com/webhook

# PostgreSQL
POSTGRES_DB=taskbot
POSTGRES_USER=taskbot
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_URL=jdbc:postgresql://localhost:5432/taskbot

# Encryption (32-byte hex for AES-256)
ENCRYPTION_SECRET_KEY=your-32-byte-hex-secret-key-here

# Admin users (comma-separated Telegram IDs)
ADMIN_TELEGRAM_IDS=123456789,987654321

# Rate Limiting
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_PER_MINUTE=5
